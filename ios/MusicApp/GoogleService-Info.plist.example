<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Replace this stub with the real GoogleService-Info.plist from the Firebase console:
  Project settings → Your apps → iOS app → Download GoogleService-Info.plist

  Add the downloaded file to the MusicApp Xcode target (Copy Bundle Resources).
  Do not commit production secrets if your org policy forbids it; use CI secrets instead.
-->
<plist version="1.0">
<dict>
  <key>CLIENT_ID</key>
  <string>REPLACE_ME.apps.googleusercontent.com</string>
  <key>REVERSED_CLIENT_ID</key>
  <string>com.googleusercontent.apps.REPLACE_ME</string>
  <key>API_KEY</key>
  <string>REPLACE_ME</string>
  <key>GCM_SENDER_ID</key>
  <string>REPLACE_ME</string>
  <key>PLIST_VERSION</key>
  <string>1</string>
  <key>BUNDLE_ID</key>
  <string>com.monkeymakes.MusicApp</string>
  <key>PROJECT_ID</key>
  <string>REPLACE_ME</string>
  <key>STORAGE_BUCKET</key>
  <string>REPLACE_ME.appspot.com</string>
  <key>IS_ADS_ENABLED</key>
  <false/>
  <key>IS_ANALYTICS_ENABLED</key>
  <true/>
  <key>IS_APPINVITE_ENABLED</key>
  <true/>
  <key>IS_GCM_ENABLED</key>
  <true/>
  <key>IS_SIGNIN_ENABLED</key>
  <true/>
  <key>GOOGLE_APP_ID</key>
  <string>1:REPLACE_ME:ios:REPLACE_ME</string>
</dict>
</plist>
